{
  "name": "lastfm-scrobbler",
  "version": "0.0.0",
  "private": true,
  "description": "A native, cross-platform Last.fm scrobbler for macOS, Windows, and Linux.",
  "keywords": [
    "lastfm",
    "scrobbler",
    "electron",
    "desktop",
    "cross-platform",
    "media-session"
  ],
  "homepage": "https://github.com/Vaporjawn/Last-FM-Scrobbler#readme",
  "bugs": {
    "url": "https://github.com/Vaporjawn/Last-FM-Scrobbler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaporjawn/Last-FM-Scrobbler.git"
  },
  "license": "MIT",
  "author": {
    "name": "Victor Williams",
    "email": "victor.williams.dev@gmail.com",
    "url": "https://github.com/Vaporjawn"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "trustedDependencies": [
    "electron",
    "better-sqlite3",
    "esbuild"
  ],
  "overrides": {
    "node-gyp": ">=11.0.0",
    "form-data": ">=4.0.6",
    "tar": ">=7.5.21",
    "tough-cookie": ">=4.1.3",
    "uuid": ">=11.1.1",
    "qs": ">=6.14.1",
    "xml2js": ">=0.5.0",
    "vitest": "4.1.11"
  },
  "scripts": {
    "start": "node scripts/run-workspaces.mjs dev --package @lastfm-scrobbler/desktop",
    "dev": "node scripts/run-workspaces.mjs dev --package @lastfm-scrobbler/desktop",
    "build": "node scripts/run-workspaces.mjs build",
    "test": "node scripts/run-workspaces.mjs test",
    "test:watch": "node scripts/run-workspaces.mjs test:watch --package @lastfm-scrobbler/desktop",
    "test:coverage": "node scripts/run-workspaces.mjs test:coverage",
    "test:e2e": "node scripts/run-workspaces.mjs test:e2e --package @lastfm-scrobbler/desktop",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/run-workspaces.mjs package --package @lastfm-scrobbler/desktop",
    "package:dir": "node scripts/run-workspaces.mjs package:dir --package @lastfm-scrobbler/desktop",
    "package:mac": "node scripts/run-workspaces.mjs package:mac --package @lastfm-scrobbler/desktop",
    "package:win": "node scripts/run-workspaces.mjs package:win --package @lastfm-scrobbler/desktop",
    "package:linux": "node scripts/run-workspaces.mjs package:linux --package @lastfm-scrobbler/desktop",
    "deploy:bug-report-relay": "node scripts/run-workspaces.mjs deploy --package @lastfm-scrobbler/bug-report-relay"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.11.0",
    "jscpd": "5.0.16",
    "prettier": "^3.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
